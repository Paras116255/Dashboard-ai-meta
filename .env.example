# Database
DATABASE_URL="postgresql://adpilot:adpilot_secret@localhost:5432/adpilot_db?schema=public"

# Redis & Background Workers
REDIS_URL="redis://localhost:6379"

# Auth & Security
JWT_SECRET="adpilot_super_secret_jwt_key_32_bytes_long_min!"
ENCRYPTION_KEY="adpilot_meta_token_encryption_key_32bytes"
NEXTAUTH_URL="http://localhost:3000"

# Meta API Settings
META_APP_ID="mock_meta_app_id_12345"
META_APP_SECRET="mock_meta_app_secret_abcde"
META_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"
META_GRAPH_API_VERSION="v20.0"
USE_MOCK_META_API="true"

# AI Provider Settings
AI_PROVIDER="mock" # 'openai' or 'mock'
OPENAI_API_KEY="sk-mock-key-for-local-dev"
OPENAI_MODEL="gpt-4o"

# Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="adpilot-assets"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# App Mode
NODE_ENV="development"
